{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ich1990.github.io/trips/trips/data/trip.schema.json",
  "title": "Trip",
  "type": "object",
  "additionalProperties": false,
  "required": ["stops"],
  "properties": {
    "view": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": { "type": "number" },
      "description": "地图初始中心 [lat, lng] 和缩放。"
    },
    "days": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/day" }
    },
    "stops": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/stop" },
      "description": "没有日期切换的一日行程使用 stops，而不是 days。"
    }
  },
  "oneOf": [
    { "required": ["days"] },
    { "required": ["stops"] }
  ],
  "$defs": {
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "weekday", "color", "stops"],
      "properties": {
        "date": { "type": "string", "minLength": 1 },
        "weekday": { "type": "string", "minLength": 1 },
        "title": { "type": "string" },
        "meta": { "type": "string" },
        "color": { "type": "string", "pattern": "^var\\(--route-[1-9]\\)$" },
        "zoom": { "type": "number" },
        "mode": { "enum": ["foot", "eurostar"] },
        "flightStat": { "type": "string" },
        "stops": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/stop" }
        }
      }
    },
    "stop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "lat", "lng", "activities"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "time": { "type": "string" },
        "drive": { "type": "string" },
        "lat": { "type": "number" },
        "lng": { "type": "number" },
        "kind": { "enum": ["stay", "highlight"] },
        "leg": { "enum": ["flight", "taxi", "metro", "slide"] },
        "optional": { "type": "boolean" },
        "note": { "type": "string" },
        "activities": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/activity" }
        }
      }
    },
    "activity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["time", "text"],
      "properties": {
        "time": { "type": "string", "minLength": 1 },
        "text": { "type": "string", "minLength": 1 }
      }
    }
  }
}
